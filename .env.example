# navigator-orchestrator — example configuration.
#
# Copy to `.env` and edit. `.env` is gitignored; never commit real values.
# Nothing here is a secret: every credential is read from the environment at
# run time and no key or token is ever sent to the browser.

# --- model -------------------------------------------------------------------
# Format: "<provider>:<model-id>". Supported prefixes:
#   fake:      deterministic, offline, no network — the default for tests
#   anthropic: Claude via the first-party API      (ANTHROPIC_API_KEY)
#   bedrock:   Claude via Amazon Bedrock           (standard AWS credentials)
#   vertex:    Gemini via Google Vertex AI         (GOOGLE_APPLICATION_CREDENTIALS)
#
# `fake:` is the default on purpose. A real prefix makes billable calls, so it
# should be a deliberate choice rather than something inherited from a template.
NAVIGATOR_MODEL=fake:local

# Sampling. Leave temperature unset unless the provider accepts it — some
# current models reject the parameter outright rather than ignoring it.
# NAVIGATOR_TEMPERATURE=0

# Optional allowlist for the client-settable `?model=` override. Empty accepts
# any model, which is convenient while comparing them and wrong in production.
# NAVIGATOR_ALLOWED_MODELS=fake:local,anthropic:claude-sonnet-4-6

# --- stores ------------------------------------------------------------------
# "memory" keeps runs in-process: they are lost on restart. Suitable for local
# development and the reference demo, not for anything durable.
NAVIGATOR_RUN_STORE=memory

# Optional. Absent means the in-memory cache and no checkpoint database.
# NAVIGATOR_REDIS_URL=redis://localhost:6379/0
# NAVIGATOR_DATABASE_URL=postgresql://navigator:navigator@localhost:5432/navigator

# --- identity ----------------------------------------------------------------
# When true, a decision requires a principal header. The console is expected to
# sit behind a trusted ingress that sets it; the app never holds a credential.
# NAVIGATOR_REQUIRE_PRINCIPAL=false
# NAVIGATOR_PRINCIPAL_HEADER=x-navigator-principal

# --- observability -----------------------------------------------------------
# All optional. Absent means tracing is a no-op.
# NAVIGATOR_LANGFUSE_PUBLIC_KEY=
# NAVIGATOR_LANGFUSE_SECRET_KEY=
# NAVIGATOR_LANGFUSE_HOST=
